title: Poppy
---
<<wait 0.1>>
<<if $day == 1>>
    <<jump Poppy_Day1>>
<<elseif $day == 2>>
    <<jump Poppy_Day2>>
<<elseif $day == 3>>
    <<jump Poppy_Day1>>
<<elseif $day == 4>>
    <<jump Poppy_Day1>>
<<elseif $day == 5>>
    <<jump Poppy_Day1>>
<<endif>>
